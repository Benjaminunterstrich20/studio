{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A news article or announcement.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string",
          "description": "A short subtitle or summary for the article."
        },
        "content": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of a custom image for the article."
        },
        "category": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last update."
        },
        "prioritized": {
          "type": "boolean"
        }
      },
      "required": [
        "slug",
        "title",
        "content",
        "category",
        "author",
        "publishedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "email_password"
    ]
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": {
        "$ref": "#/entities/Article"
      },
      "description": "Collection of articles."
    }
  }
}
